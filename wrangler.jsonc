{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level = local development only (miniflare, local D1/R2).
  "name": "sporteka-local",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "binding": "ASSETS", "directory": "./dist/client", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "sporteka-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "RL_GO", "namespace_id": "76001", "simple": { "limit": 40, "period": 60 } },
    { "name": "RL_SEARCH", "namespace_id": "76003", "simple": { "limit": 90, "period": 60 } }
  ],
  "vars": { "ENVIRONMENT": "local", "SITE_URL": "http://localhost:8798", "ALLOWED_HOSTS": "localhost,127.0.0.1" },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
