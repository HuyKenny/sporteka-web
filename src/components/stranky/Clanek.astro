---
// Blog post / page. Content HTML comes from WordPress (content.rendered); posts get the "Kde vybrat a koupit" links,
// related posts. External links get rel="nofollow noopener" in the middleware (WordPress rule).
import Base from '../../layouts/Base.astro';
import Drobky from '../Drobky.astro';
import PostKarta from '../PostKarta.astro';
import type { postView } from '../../lib/views';
import { datum, decode, texturize } from '../../lib/format';
import { ownUpload } from '../../lib/img';

interface Props { v: NonNullable<Awaited<ReturnType<typeof postView>>> }
const { v } = Astro.props;
const m = v.meta;
const p = v.post;
const isPost = p.type === 'post';
const crumbs = isPost ? [{ name: 'Domů', url: '/' }, { name: 'Rádce', url: '/blog/' }, ...(v.cat ? [{ name: decode(v.cat.name), url: `/${v.cat.slug}/` }] : []), { name: decode(p.title) }] : [{ name: 'Domů', url: '/' }, { name: decode(p.title) }];
---
<Base title={m.title} description={m.description} canonical={m.canonical} robots={m.robots} ogImage={m.ogImage} graph={m.graph} jsonLd={m.jsonLd} extraMeta={m.extraMeta} pageType={isPost ? 'post' : 'page'}>
	<div class="w">
		<Drobky items={crumbs} />
		<article class="cl">
			{isPost && v.cat && <a class="cl__k" href={`/${v.cat.slug}/`}>{decode(v.cat.name)}</a>}
			<h1>{texturize(decode(p.title))}</h1>
			{isPost && <p class="cl__m">{p.author || 'Sporteka.cz'} · <time datetime={p.published_at.slice(0, 10)}>{datum(p.published_at)}</time>{p.modified_at.slice(0, 10) > p.published_at.slice(0, 10) && <> · aktualizováno <time datetime={p.modified_at.slice(0, 10)}>{datum(p.modified_at)}</time></>}</p>}
			{isPost && p.image && <figure class="cl__f"><img src={ownUpload(p.image)} alt={p.image_alt} width={p.image_w || 1400} height={p.image_h || 788} fetchpriority="high" decoding="async" /></figure>}
			<div class="obsah" set:html={p.content_html.replace(' onsubmit="return false"', '').replace(/(src|srcset)="https?:\/\/(?:www\.)?sporteka\.cz\/wp-content\//g, '$1="/wp-content/').replace(/, https?:\/\/(?:www\.)?sporteka\.cz\/wp-content\//g, ', /wp-content/')} />
			{v.shopCats.length > 0 && (
				<div class="cl__s"><b>Kde vybrat a koupit za nejlepší cenu</b>{v.shopCats.map((c) => <a href={`/${c.slug}/`}>{decode(c.name)}</a>)}</div>
			)}
		</article>
		{v.related.length > 0 && (
			<section class="sek">
				<div class="sek__h"><h2>Mohlo by vás zajímat</h2><a href="/blog/">Celý rádce</a></div>
				<ul class="pc pc--4">{v.related.map((r) => <PostKarta p={r} h="h3" perex={false} />)}</ul>
			</section>
		)}
	</div>
</Base>
