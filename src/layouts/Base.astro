---
// Page shell: head (Rank Math-equivalent meta, OG, JSON-LD), header, footer, GA4 + consent, UI script.
import '../styles/app.css';
import '../styles/trail.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ga4Head, ga4Footer } from '../lib/analytics';
import { GA4_ID, OG_DEFAULT, SITE_NAME, orgGraph } from '../lib/site';
import { getEnv, isStatic } from '../lib/server/env';

interface Props {
	title: string;
	description?: string | undefined;
	/** Absolute canonical URL; omit where WordPress printed none (search, 404). */
	canonical?: string | undefined;
	prev?: string | undefined;
	next?: string | undefined;
	/** Rank Math robots directives, e.g. ['follow','index',…] */
	robots: string[];
	ogType?: string | undefined;
	ogImage?: string | undefined;
	/** Nodes appended to the Rank Math @graph (WebPage, Product, BlogPosting …). */
	graph?: unknown[] | undefined;
	/** Standalone JSON-LD scripts (BreadcrumbList, ItemList, FAQPage …). */
	jsonLd?: unknown[] | undefined;
	/** home | product | category | brand | post | page | blog | search | 404 (GA4 page_type) */
	pageType: string;
	/** Short Organization node (Rank Math prints it on product-category archives). */
	shortOrg?: boolean | undefined;
	extraMeta?: Array<{ property?: string; name?: string; content: string }> | undefined;
	/** Homepage: SearchAction in the WebSite node (sitelinks search box). */
	searchAction?: boolean | undefined;
}
const { title, description = '', canonical, prev, next, robots, ogType = 'article', ogImage = OG_DEFAULT, graph = [], jsonLd = [], pageType, shortOrg = false, extraMeta = [], searchAction = false } = Astro.props;
const env = getEnv();
const prod = env.ENVIRONMENT === 'production';
// meta robots = production value everywhere (parity checks compare it); non-production hosts are closed by Access and
// the middleware's X-Robots-Tag: noindex header.
const robotsContent = env.ENVIRONMENT === 'local' ? 'noindex, nofollow' : robots.join(', ');
const ga = prod || env.ANALYTICS_ENABLED === '1' ? GA4_ID : '';
const ld = (o: unknown) => JSON.stringify(o).replace(/</g, '\\u003c');
---
<!DOCTYPE html>
<html lang="cs" data-static={isStatic() ? '1' : undefined}>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{title}</title>
	{description && <meta name="description" content={description} />}
	<meta name="robots" content={robotsContent} />
	{canonical && <link rel="canonical" href={canonical} />}
	{prev && <link rel="prev" href={prev} />}
	{next && <link rel="next" href={next} />}
	<meta property="og:locale" content="cs_CZ" />
	<meta property="og:type" content={ogType} />
	<meta property="og:title" content={title} />
	{description && <meta property="og:description" content={description} />}
	{canonical && <meta property="og:url" content={canonical} />}
	<meta property="og:site_name" content={SITE_NAME} />
	<meta property="og:image" content={ogImage} />
	{extraMeta.map((m) => (m.property ? <meta property={m.property} content={m.content} /> : <meta name={m.name} content={m.content} />))}
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	{description && <meta name="twitter:description" content={description} />}
	<meta name="twitter:image" content={ogImage} />
	<link rel="preload" href="/fonts/barlow-c-700.woff2" as="font" type="font/woff2" crossorigin />
	<link rel="preload" href="/fonts/figtree-1.woff2" as="font" type="font/woff2" crossorigin />
	<link rel="icon" href="/a/favicon.svg?v=4" type="image/svg+xml" />
	<link rel="icon" href="/a/favicon-32.png?v=4" sizes="32x32" type="image/png" />
	<link rel="apple-touch-icon" href="/a/favicon-180.png?v=4" />
	<link rel="manifest" href="/a/manifest.webmanifest" />
	<meta name="theme-color" content="#034F25" />
	{ga && <Fragment set:html={ga4Head(ga, pageType)} />}
	<script type="application/ld+json" set:html={ld({ '@context': 'https://schema.org', '@graph': [...orgGraph(shortOrg, searchAction), ...graph] })} />
	{jsonLd.map((d) => <script type="application/ld+json" set:html={ld(d)} />)}
	<!-- a shop photo that does not load (dead link, the shop refuses hotlinking) → placeholder; must run before the images do -->
	<script is:inline>document.addEventListener('error',function(e){var t=e.target;if(t&&t.tagName==='IMG'&&!t.dataset.fail){t.dataset.fail='1';t.removeAttribute('srcset');t.src='/a/bez-foto.svg';}},true);</script>
	<slot name="head" />
</head>
<body class={`t-${pageType}`}>
<Header />
<main id="obsah" tabindex="-1">
<slot />
</main>
<Footer />
<script src="../scripts/ui.ts"></script>
{ga && <Fragment set:html={ga4Footer(ga, pageType)} />}
</body>
</html>
